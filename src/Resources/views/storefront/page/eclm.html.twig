{% sw_extends '@Storefront/storefront/base.html.twig' %}

{% block base_head %}
    {{ parent() }}
    <script>
        window.Snippets = {};
        Snippets.eventNotAvailable = '{{ 'label-me.eventNotAvailable'|trans|raw }}';
        Snippets.eventNotAvailableMessage = '{{ 'label-me.eventNotAvailableMessage'|trans|raw }}';
        Snippets.candyNotAvailable = '{{ 'label-me.candyNotAvailable'|trans|raw }}';
        Snippets.candyNotAvailableMessage = '{{ 'label-me.candyNotAvailableMessage'|trans|raw }}';
        Snippets.cancelPolicy = '{{ 'label-me.cancelPolicy'|trans|raw }}';
    </script>
{% endblock %}

{% block base_content %}
    <div class="cms-page eclm-outer-container" style="min-height: 120vh;">
        <div id="eclm_storefront_app">
            <App/>
        </div>
    </div>
{% endblock %}
