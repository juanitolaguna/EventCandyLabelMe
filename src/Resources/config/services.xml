<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>

        <!-- Definitions -->
        <service id="EventCandy\LabelMe\Core\Content\Candy\CandyDefinition">
            <tag name="shopware.entity.definition" entity="eclm_candy"/>
        </service>

        <service id="EventCandy\LabelMe\Core\Content\Event\EventDefinition">
            <tag name="shopware.entity.definition" entity="eclm_event"/>
        </service>

        <service id="EventCandy\LabelMe\Core\Content\Label\LabelDefinition">
            <tag name="shopware.entity.definition" entity="eclm_label"/>
        </service>

        <service id="EventCandy\LabelMe\Core\Content\Package\PackageDefinition">
            <tag name="shopware.entity.definition" entity="eclm_package"/>
        </service>

        <service id="EventCandy\LabelMe\Core\Content\CandyPackage\CandyPackageDefinition">
            <tag name="shopware.entity.definition" entity="eclm_candy_package"/>
        </service>

        <service id="EventCandy\LabelMe\Storefront\Controller\LabelMeController" public="true">
            <argument type="service" id="Shopware\Storefront\Page\Navigation\NavigationPageLoader"/>

            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="EventCandy\LabelMe\Storefront\Controller\LabelMeApiController" public="true">
            <argument type="service" id="eclm_event.repository"/>
            <argument type="service" id="eclm_label.repository"/>
            <argument type="service" id="eclm_candy.repository"/>
            <argument type="service" id="eclm_candy_package.repository"/>
            <argument type="service" id="currency.repository"/>
            <argument type="service" id="media.repository"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\SalesChannel\CartService"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\CartPersister"/>
            <argument type="service" id="EventCandy\Sets\Storefront\Page\Product\Subscriber\ProductListingSubscriber"/>
            <argument type="service" id="translator" on-invalid="null" />
        </service>

        <service id="EventCandy\LabelMe\Core\Checkout\EclmSubProductCartReducer">
            <tag name="ec.sets.cart_reducer"/>
        </service>

        <service id="EventCandy\LabelMe\Core\Checkout\Cart\EclmCartProcessor" public="true">
            <argument type="service" id="Shopware\Core\Checkout\Cart\Price\QuantityPriceCalculator"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\Price\PercentagePriceCalculator"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\Price\AbsolutePriceCalculator"/>
            <argument type="service" id="media.repository"/>
            <argument type="service" id="product.repository"/>
            <argument type="service" id="sales_channel.product.repository"/>
            <argument type="service"
                      id="Shopware\Core\Content\Product\SalesChannel\Price\ProductPriceDefinitionBuilderInterface"/>
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="EventCandy\Sets\Storefront\Page\Product\Subscriber\ProductListingSubscriber"/>
            <argument type="service" id="event_dispatcher"/>


            <!-- inject before product processor (5000) -->
            <tag name="shopware.cart.processor" priority="6000"/>
            <tag name="shopware.cart.collector" priority="6000"/>
        </service>

        <service id="EventCandy\LabelMe\Core\Checkout\Cart\LineItemFactoryHandler\LabelMeLineItemFactory">
            <argument type="service" id="Shopware\Core\Checkout\Cart\PriceDefinitionFactory"/>
            <tag name="shopware.cart.line_item.factory"/>
        </service>

        <!-- DemoDataService -->

        <service id="EventCandy\LabelMe\DemoDataService">
            <argument type="service" id="Shopware\Core\Framework\Api\Controller\SyncController"/>
            <argument type="tagged" tag="eclm.demo_data.data_provider"/>
        </service>

        <!--  DemoDataProviders -->
        <service id="EventCandy\LabelMe\DataProvider\DemoDataProvider" abstract="true">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="Shopware\Core\Content\Media\File\FileSaver"/>
        </service>

        <!-- Create Plugin Media Folder and Data -->
        <service id="EventCandy\LabelMe\DataProvider\BaseMediaProvider">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="Shopware\Core\Content\Media\File\FileSaver"/>
            <argument type="service" id="media_folder.repository"/>
            <argument type="service" id="media_folder_configuration.repository"/>

            <tag name="eclm.demo_data.data_provider" priority="1100"/>
        </service>


        <service id="EventCandy\LabelMe\DataProvider\CandyMediaProvider"
                 parent="EventCandy\LabelMe\DataProvider\DemoDataProvider">
            <tag name="eclm.demo_data.data_provider" priority="1000"/>
        </service>

        <service id="EventCandy\LabelMe\DataProvider\CandyProvider"
                 parent="EventCandy\LabelMe\DataProvider\DemoDataProvider">
            <tag name="eclm.demo_data.data_provider" priority="900"/>
        </service>

        <service id="EventCandy\LabelMe\DataProvider\PackageMediaProvider"
                 parent="EventCandy\LabelMe\DataProvider\DemoDataProvider">
            <tag name="eclm.demo_data.data_provider" priority="800"/>
        </service>

        <service id="EventCandy\LabelMe\DataProvider\PackageProvider"
                 parent="EventCandy\LabelMe\DataProvider\DemoDataProvider">
            <tag name="eclm.demo_data.data_provider" priority="700"/>
        </service>

        <service id="EventCandy\LabelMe\DataProvider\EventMediaProvider"
                 parent="EventCandy\LabelMe\DataProvider\DemoDataProvider">
            <tag name="eclm.demo_data.data_provider" priority="600"/>
        </service>

        <service id="EventCandy\LabelMe\DataProvider\EventProvider"
                 parent="EventCandy\LabelMe\DataProvider\DemoDataProvider">
            <tag name="eclm.demo_data.data_provider" priority="500"/>
        </service>

        <service id="EventCandy\LabelMe\DataProvider\LabelMediaProvider"
                 parent="EventCandy\LabelMe\DataProvider\DemoDataProvider">
            <tag name="eclm.demo_data.data_provider" priority="400"/>
        </service>

        <service id="EventCandy\LabelMe\DataProvider\LabelProvider"
                 parent="EventCandy\LabelMe\DataProvider\DemoDataProvider">
            <tag name="eclm.demo_data.data_provider" priority="300"/>
        </service>

        <service id="EventCandy\LabelMe\DataProvider\CandyPackageProvider"
                 parent="EventCandy\LabelMe\DataProvider\DemoDataProvider">
            <tag name="eclm.demo_data.data_provider" priority="200"/>
        </service>


        <!-- Commands  -->
        <service id="EventCandy\LabelMe\Commands\EclmCommands">
            <argument type="service" id="Doctrine\DBAL\Connection"/>
            <argument type="service" id="media_folder.repository"/>
            <tag name="console.command"/>
        </service>

    </services>
</container>
