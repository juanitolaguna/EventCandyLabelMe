<?xml version="1.0" ?>

<container xmlns="http://symfony.com/schema/dic/services"
           xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
           xsi:schemaLocation="http://symfony.com/schema/dic/services http://symfony.com/schema/dic/services/services-1.0.xsd">

    <services>
        <service id="EventCandy\LabelMe\Core\Content\Candy\CandyDefinition">
            <tag name="shopware.entity.definition" entity="eclm_candy"/>
        </service>

        <service id="EventCandy\LabelMe\Core\Content\Event\EventDefinition">
            <tag name="shopware.entity.definition" entity="eclm_event"/>
        </service>

        <service id="EventCandy\LabelMe\Core\Content\Label\LabelDefinition">
            <tag name="shopware.entity.definition" entity="eclm_label"/>
        </service>

        <service id="EventCandy\LabelMe\Core\Content\Package\PackageDefinition">
            <tag name="shopware.entity.definition" entity="eclm_package"/>
        </service>

        <service id="EventCandy\LabelMe\Core\Content\CandyPackage\CandyPackageDefinition">
            <tag name="shopware.entity.definition" entity="eclm_candy_package"/>
        </service>

        <service id="EventCandy\LabelMe\Storefront\Controller\LabelMeController" public="true">
            <argument type="service" id="Shopware\Storefront\Page\Navigation\NavigationPageLoader"/>

            <call method="setContainer">
                <argument type="service" id="service_container"/>
            </call>
        </service>

        <service id="EventCandy\LabelMe\Storefront\Controller\LabelMeApiController" public="true">
            <argument type="service" id="eclm_event.repository"/>
            <argument type="service" id="eclm_label.repository"/>
            <argument type="service" id="eclm_candy.repository"/>
            <argument type="service" id="eclm_candy_package.repository"/>
            <argument type="service" id="Shopware\Core\System\SystemConfig\SystemConfigService"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\SalesChannel\CartService"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\CartPersister"/>
            <argument type="service" id="logger"/>
        </service>

        <service id="EventCandy\LabelMe\Core\Checkout\Cart\EclmCartProcessor" public="true">
            <argument type="service" id="logger"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\Price\PercentagePriceCalculator"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\Price\AbsolutePriceCalculator"/>
            <argument type="service" id="Shopware\Core\Checkout\Cart\Price\QuantityPriceCalculator"/>
            <argument type="service" id="media.repository"/>


            <!-- inject before product processor (5000) -->
            <tag name="shopware.cart.processor" priority="6000" />
            <tag name="shopware.cart.collector" priority="6000" />
        </service>



    </services>
</container>
