module.exports = "<sw-page class=\"event-detail-page\" :showSearchBar=\"false\">\n    <template #smart-bar-header>\n        <h2>Event Details</h2>\n    </template>\n\n    <template #smart-bar-actions>\n        <sw-button-process\n            variant=\"primary\"\n            @click=\"onClickSave\"\n            @process-finish=\"saveFinish\"\n            :isLoading=\"isLoading\"\n            :processSuccess=\"processSuccess\">\n            Save\n        </sw-button-process>\n        <sw-button :routerLink=\"{ name: 'eclm.plugin.index.event' }\">\n            Cancel\n        </sw-button>\n    </template>\n\n    <template #content>\n        <sw-card-view>\n            <sw-card v-if=\"event\" :large=\"false\">\n                <sw-text-field :label=\"$t('eclm.eventDetail.name')\" v-model=\"event.name\"></sw-text-field>\n                <sw-text-field :label=\"$t('eclm.eventDetail.alternativeName')\" v-model=\"event.alternativeName\"></sw-text-field>\n                <sw-checkbox-field :label=\"$t('eclm.eventDetail.active')\" v-model=\"event.active\"></sw-checkbox-field>\n                <eclm-media-field\n                    v-model=\"event.mediaId\"\n                    @media-id-change=\"onMediaSelect\"\n                    :mediaFolderName=\"'Event Candy'\">\n                </eclm-media-field>\n            </sw-card>\n\n            <sw-card :large=false v-if=\"eventSaved\">\n\n                <template #title>\n                    <h2>\n                        Labels\n                    </h2>\n                </template>\n\n                <template #toolbar>\n                    <sw-button\n                        v-if=\"event\"\n                        variant=\"primary\"\n                        :routerLink=\"{name: 'eclm.plugin.labelCreate', params: { eventId: event.id }}\"\n                    >\n                        Add Label\n                    </sw-button>\n                </template>\n\n                <template #grid>\n                    <sw-entity-listing\n                        v-if=\"labels\"\n                        :items=\"labels\"\n                        :repository=\"labelRepository\"\n                        :showSelection=\"false\"\n                        :columns=\"labelColumns\"\n                        :fullPage=\"false\"\n                        :compactMode=\"true\"\n                        detailRoute=\"eclm.plugin.labelDetail\"\n                    ></sw-entity-listing>\n                </template>\n\n            </sw-card>\n        </sw-card-view>\n    </template>\n\n    <template #sidebar>\n        <sw-sidebar>\n            <sw-sidebar-item ref=\"eclmEventSidebar\" title=\"Image\" icon=\"default-object-image\">\n                <div class=\"event-image-container\">\n                    <img v-if=\"imageUrl\" class=\"event-image\" :src=\"imageUrl\"/>\n                </div>\n            </sw-sidebar-item>\n        </sw-sidebar>\n    </template>\n\n\n</sw-page>\n\n";