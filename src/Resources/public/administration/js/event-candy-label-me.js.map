module.exports = "<sw-page class=\"candy-detail-page\" :showSearchBar=\"false\">\n    <template #smart-bar-header>\n        <h2>Candy Details</h2>\n    </template>\n\n    <template #smart-bar-actions>\n        <sw-button-process\n            variant=\"primary\"\n            @click=\"onClickSave\"\n            @process-finish=\"saveFinish\"\n            :isLoading=\"isLoading\"\n            :processSuccess=\"processSuccess\">\n            Save\n        </sw-button-process>\n        <sw-button :routerLink=\"{ name: 'eclm.plugin.index.candy' }\">\n            Cancel\n        </sw-button>\n    </template>\n\n    <template #content>\n        <sw-card-view>\n            <sw-card v-if=\"candy\" :large=\"false\">\n                <sw-text-field :label=\"$t('eclm.candyDetail.name')\" v-model=\"candy.name\"></sw-text-field>\n\n                <sw-checkbox-field :label=\"$t('eclm.candyDetail.active')\" v-model=\"candy.active\"></sw-checkbox-field>\n\n                <sw-text-field :label=\"$t('eclm.candyDetail.infoBadge')\" v-model=\"candy.infoBadge\"></sw-text-field>\n\n                <sw-colorpicker  zIndex=\"1055\" :label=\"$t('eclm.candyDetail.infoBadgeColor')\" v-model=\"candy.infoBadgeColor\"></sw-colorpicker>\n\n                <eclm-media-field\n                        v-model=\"candy.mediaId\"\n                        :showUploadField=\"false\"\n                        :showControls=\"false\"\n                        @media-id-change=\"onMediaSelect\"\n                        :mediaFolderName=\"'Event Candy'\">\n                </eclm-media-field>\n            </sw-card>\n\n\n            <sw-card v-if=\"candy\" :large=\"false\">\n                <sw-text-editor\n                        type=\"textarea\"\n                        :label=\"$tc('eclm.candyDetail.productDataLabel')\"\n                        :placeholder=\"$tc('eclm.candyDetail.productDataPlaceholder')\"\n                        v-model=\"candy.productData\">\n                </sw-text-editor>\n            </sw-card>\n\n\n\n            <sw-card v-if=\"candySaved && packageOptions\" :large=\"false\">\n                <sw-multi-select\n                    :label=\"'Packages'\"\n                    :options=\"packageOptions\"\n                    :value=\"packageValues\"\n\n                    :isLoading=\"filterLoading\"\n                    valueProperty=\"id\"\n                    labelProperty=\"name\"\n                    @item-add=\"onPackageAdd\"\n                    @item-remove=\"onPackageRemove\"\n                >\n                </sw-multi-select>\n            </sw-card>\n\n        </sw-card-view>\n    </template>\n\n    <template #sidebar>\n        <sw-sidebar>\n            <sw-sidebar-item ref=\"eclmSidebar\" title=\"Image\" icon=\"default-object-image\">\n                <div class=\"candy-image-container\">\n                    <img v-if=\"imageUrl\" class=\"candy-image\" :src=\"imageUrl\"/>\n                </div>\n            </sw-sidebar-item>\n        </sw-sidebar>\n    </template>\n\n</sw-page>\n\n";