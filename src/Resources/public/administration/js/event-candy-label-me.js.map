module.exports = "<sw-page class=\"candy-package-detail-page\" :showSearchBar=\"false\">\n    <template #smart-bar-header>\n        <h2>Candy/Package Details</h2>\n    </template>\n\n    <template #smart-bar-actions>\n        <sw-button-process\n            variant=\"primary\"\n            @click=\"onClickSave\"\n            @process-finish=\"saveFinish\"\n            :isLoading=\"isLoading\"\n            :processSuccess=\"processSuccess\">\n            Save\n        </sw-button-process>\n        <sw-button :routerLink=\"{ name: 'eclm.plugin.index.candyPackages' }\">\n            Cancel\n        </sw-button>\n    </template>\n\n    <template #content>\n        <sw-card-view>\n            <sw-card v-if=\"joinedCandyPackage\">\n                <p><strong>Candy Name:</strong> {{ joinedCandyPackage.candy.name }}</p>\n                <br>\n                <p><strong>Package Name:</strong> {{ joinedCandyPackage.package.name }}</p>\n            </sw-card>\n\n            <sw-card>\n{#                <sw-number-field  numberType=\"int\" :label=\"'Gramm'\" v-model=\"joinedCandyPackage.gramm\" validation=\"required\"></sw-number-field>#}\n\n{#                <sw-entity-single-select#}\n{#                    entity=\"sales_channel\"#}\n{#                    :label=\"$tc('sw-customer.baseForm.labelSalesChannel')\"#}\n{#                    :placeholder=\"$tc('sw-customer.baseForm.placeholderSalesChannel')\"#}\n{#                    :value=\"customer.salesChannelId\"#}\n{#                    @change=\"onSalesChannelChange\"#}\n{#                    :error=\"customerSalesChannelIdError\">#}\n{#                </sw-entity-single-select>#}\n\n\n{#                <sw-single-select#}\n{#                    :helpText=\"'Weise ein Produkt zu'\"#}\n{#                    :label=\"'Produkt'\"#}\n{#                    v-model=\"products.name\"#}\n{#                    :options=\"categoryTypes\">#}\n{#                </sw-single-select>#}\n\n                <sw-single-select\n                    v-if=\"products.length\"\n                    :options=\"productOptions\"\n                    labelValue=\"label\"\n                    valueProperty=\"value\"\n                    :placeholder=\"'Füge ein Produkt hinzu'\"\n                    :label=\"'Produkt'\"\n                    :value=\"joinedCandyPackage.productId\"\n                    @change=\"changeProduct\"\n                    @search=\"searchProduct\"\n                    @select-expanded=\"getProducts\"\n                    required\n                >\n                </sw-single-select>\n            </sw-card>\n\n            <sw-card v-if=\"joinedCandyPackage\" :large=\"false\">\n                <eclm-media-field\n                    v-model=\"joinedCandyPackage.mediaId\"\n                    @media-id-change=\"onMediaSelect\"\n                    :mediaFolderName=\"'Event Candy'\">\n                </eclm-media-field>\n            </sw-card>\n\n        </sw-card-view>\n    </template>\n\n    <template #sidebar>\n        <sw-sidebar>\n            <sw-sidebar-item ref=\"eclmSidebar\" title=\"Image\" icon=\"default-object-image\">\n                <div class=\"candy-package-image-container\">\n                    <img v-if=\"imageUrl\" class=\"candy-package-image\" :src=\"imageUrl\"/>\n                </div>\n            </sw-sidebar-item>\n        </sw-sidebar>\n    </template>\n\n\n</sw-page>\n\n";