module.exports = "<sw-page class=\"label-detail-page\" :showSearchBar=\"false\">\n\n    <template #smart-bar-back>\n        <router-link v-if=\"label\"\n                     class=\"smart-bar__back-btn\"\n                     :to=\"{ name: 'eclm.plugin.eventDetail', params: { id: label.eventId } }\"\n        >\n            <sw-icon name=\"default-arrow-head-left\" color=\"#ed1c24\" small></sw-icon>\n{#            <sw-icon name=\"default-object-puzzle-piece\" small></sw-icon>#}\n        </router-link>\n    </template>\n\n    <template #smart-bar-header>\n        <h2>Label Details</h2>\n    </template>\n\n    <template #smart-bar-actions>\n        <sw-button-process\n            variant=\"primary\"\n            @click=\"onClickSave\"\n            @process-finish=\"saveFinish\"\n            :isLoading=\"isLoading\"\n            :processSuccess=\"processSuccess\">\n            Save\n        </sw-button-process>\n        <sw-button v-if=\"label\" :routerLink=\"{ name: 'eclm.plugin.eventDetail', params: { id: label.eventId } }\">\n            Cancel\n        </sw-button>\n    </template>\n\n    <template #content>\n        <sw-card-view>\n            <sw-card v-if=\"label\" :large=\"false\">\n                <sw-text-field :label=\"$t('eclm.labelDetail.name')\" v-model=\"label.name\"></sw-text-field>\n                <sw-checkbox-field :label=\"$t('eclm.labelDetail.active')\" v-model=\"label.active\"></sw-checkbox-field>\n                <eclm-media-field\n                    v-model=\"label.mediaId\"\n                    :showUploadField=\"false\"\n                    :showControls=\"false\"\n                    @media-id-change=\"onMediaSelect\"\n                    :mediaFolderName=\"'Event Candy'\">\n                </eclm-media-field>\n            </sw-card>\n        </sw-card-view>\n    </template>\n\n    <template #sidebar>\n        <sw-sidebar>\n            <sw-sidebar-item ref=\"eclmSidebar\" title=\"Image\" icon=\"default-object-image\">\n                <div class=\"label-image-container\">\n                    <img class=\"label-image\" :src=\"imageUrl\"/>\n                </div>\n            </sw-sidebar-item>\n        </sw-sidebar>\n    </template>\n\n\n</sw-page>\n\n";