<sw-card :large="false">

    <template #toolbar>
        <sw-button
            variant="primary"
            :routerLink="{ name: 'eclm.plugin.eventCreate' }"
        >
            Add Event
        </sw-button>
    </template>

    <template #grid>
        <sw-entity-listing
            v-if="events"
            :items="events"
            :repository="repository"
            :showSelection="false"
            :columns="columns"
            :fullPage="false"
            :compactMode="true"
            detailRoute="eclm.plugin.eventDetail"
        ></sw-entity-listing>

    </template>
</sw-card>
