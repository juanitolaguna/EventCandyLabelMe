<sw-card :large="false">

    <template #toolbar>
        <sw-button variant="primary" :routerLink="{ name: 'eclm.plugin.candyCreate' }">
            Add Candy
        </sw-button>
    </template>

    <template #grid>
        <sw-entity-listing
            v-if="candies"
            :items="candies"
            :repository="repository"
            :showSelection="false"
            :columns="columns"
            :fullPage="false"
            :compactMode="true"
            detailRoute="eclm.plugin.candyDetail"
        ></sw-entity-listing>

    </template>
</sw-card>

