<sw-card :large="false">

    <template #toolbar>
        <sw-button >Add Candy</sw-button>
    </template>

    <template #grid>
        <sw-entity-listing
            v-if="candies"
            :items="candies"
            :repository="repository"
            :showSelection="false"
            :columns="columns"
            :fullPage="false"
            :compactMode="true"
        >
        </sw-entity-listing>

    </template>
</sw-card>

