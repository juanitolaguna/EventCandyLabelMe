        <sw-tabs>

            <sw-tabs-item :route="{ name: 'eclm.plugin.index.event' }">
                Event
            </sw-tabs-item>

            <sw-tabs-item :route="{ name: 'eclm.plugin.index.candy' }">
                Candy
            </sw-tabs-item>

            <sw-tabs-item
